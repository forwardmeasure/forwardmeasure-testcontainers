<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.forwardmeasure.testcontainers</groupId>
    <artifactId>forwardmeasure-testcontainers-parent</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>forwardmeasure-testcontainers-kafka</artifactId>
  <name>ForwardMeasure Testcontainers Kafka</name>
  <dependencies>
    <!-- Real artifactId confirmed from forwardmeasure-data-streaming's own cached-jar discovery:
         Testcontainers 2.x renamed this from the older "kafka" (1.x) to "testcontainers-kafka".
         Version comes from the inherited testcontainers-bom (2.0.5, via forwardmeasure-platform) -
         no explicit version here, same as every other module in this repo. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Real client used by this module's own proof test to round-trip a real message - version
         comes from the inherited forwardmeasure-platform BOM management, no explicit version here. -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
